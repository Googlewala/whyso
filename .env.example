# ---- Whyso environment template ----
# Copy to .env and fill in the values you need. Never commit the real .env.

# --- core ---
NODE_ENV=production
PORT=12000
HOST=0.0.0.0

# Public URL of the deployment. Required in production when billing is enabled,
# because Stripe redirects back here after checkout.
APP_URL=https://whyso.example.com

# Where the SQLite database lives. Point this at a mounted volume in Docker.
WHYSO_DB=/data/whyso.db

# Set to 1 only if you want the shared demo workspace seeded. Leave 0 in production.
WHYSO_DEMO=0

# Allow public sign-ups. Set 0 for a closed/invite-only deployment.
WHYSO_ALLOW_SIGNUP=1

# Trust X-Forwarded-* headers. Enable when running behind a reverse proxy or LB.
TRUST_PROXY=1

# --- sessions & limits ---
SESSION_TTL_DAYS=30
SESSION_COOKIE=whyso_session
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_AUTH_MAX=20

# --- logging ---
LOG_LEVEL=info

# --- billing (optional) ---
# Leave blank to run without paid plans; Pro can still be toggled in dev mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PUBLISHABLE_KEY=
